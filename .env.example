# Copy to .env (git-ignored) and adjust.
PG_USER=imp
PG_PASSWORD=imp

# Comma-separated NSE symbols to keep (empty = every EQ symbol, ~2,000 rows/day)
SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN,ITC,LT,BHARTIARTL,MARUTI,MRF,PAGEIND,YESBANK,SUZLON,IRFC,ADANIENT,ZOMATO,BAJFINANCE
# AMFI scheme codes to keep (empty = all ~15k schemes)
MF_SCHEMES=120465,118989,122639,119551

# Alerts: nothing is sent unless ALERTS_SEND=true AND a channel is configured
ALERTS_SEND=false
MIN_ALERT_SCORE=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=
ALERT_EMAIL_TO=
